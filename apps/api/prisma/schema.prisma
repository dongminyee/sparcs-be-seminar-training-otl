generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  username String   @unique @db.VarChar(32)
  name     String   @db.VarChar(50)
  password String?  @db.VarChar(72)
  reviews  Review[]
}

model Lecture {
  id         Int         @id
  code       String      @db.VarChar(16)
  classNo    String      @db.VarChar(4)
  title      String      @db.VarChar(100)
  titleEn    String      @db.VarChar(150)
  department String      @db.VarChar(50)
  professor  String      @db.VarChar(50)
  credit     Int
  year       Int
  semester   Int
  deletedAt  DateTime?
  classes    ClassTime[]
  reviews    Review[]
}

model ClassTime {
  lectureId Int
  day       Int
  begin     Int
  end       Int
  room      String  @db.VarChar(64)
  lecture   Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@id([lectureId, day, begin])
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  lectureId Int
  content   String   @db.VarChar(500)
  createdAt DateTime @default(now())
  author    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  lecture   Lecture  @relation(fields: [lectureId], references: [id], onDelete: Restrict)

  @@unique([userId, lectureId])
  @@index([lectureId, id])
  @@map("review")
}

