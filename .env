# Shared localhost settings for the seminar.
MYSQL_DATABASE=mini_otl
MYSQL_USER=mini_otl
MYSQL_PASSWORD=mini_otl
MYSQL_ROOT_PASSWORD=mini_otl_root
MYSQL_PORT=13306
DATABASE_URL=mysql://mini_otl:mini_otl@127.0.0.1:13306/mini_otl
SHADOW_DATABASE_URL=mysql://mini_otl:mini_otl@127.0.0.1:13306/mini_otl_shadow

API_PORT=3001
SOURCE_PORT=3002
API_URL=http://127.0.0.1:3001
SOURCE_URL=http://127.0.0.1:3002
JWT_SECRET=mini-otl-local-jwt-secret
SOURCE_API_KEY=mini-otl-local-source-key
SYNC_CRON="*/10 * * * * *"
SOURCE_DELETE_CRON="*/30 * * * * *"
SOURCE_DELETE_AFTER_MS=90000
